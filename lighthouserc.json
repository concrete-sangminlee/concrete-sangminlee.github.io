{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/ko/index.html",
        "http://localhost/cv/index.html",
        "http://localhost/cv/ko/index.html",
        "http://localhost/publications/lee2025impactecho/index.html",
        "http://localhost/statements/research/index.html",
        "http://localhost/penguin-volley/index.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(statements|penguin-volley)/).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
