{
  "id": "./?source=pwa",
  "name": "Sequence Arena",
  "short_name": "Sequence",
  "description": "GitHub Pages에서 바로 실행되는 오프라인 솔로 시퀀스 보드게임.",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "minimal-ui",
    "standalone"
  ],
  "orientation": "portrait-primary",
  "background_color": "#061411",
  "theme_color": "#10372e",
  "categories": [
    "games",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "게임 열기",
      "short_name": "게임",
      "description": "Sequence Arena를 엽니다.",
      "url": "./"
    },
    {
      "name": "오늘의 챌린지",
      "short_name": "데일리",
      "description": "오늘의 시드 퍼즐을 바로 시작합니다.",
      "url": "./?mode=daily"
    }
  ]
}
